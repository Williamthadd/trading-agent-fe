VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# This frontend contract intentionally supports the default Firestore database.
VITE_FIREBASE_DATABASE_ID=(default)

# Optional values from the Firebase Web App config.
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MEASUREMENT_ID=

# Login is pinned to williamthudd@gmail.com in frontend code and firestore.rules.
# Configure WEB_AUTH_ALLOWED_EMAILS separately in the FastAPI backend environment.

# Needed only for starting a new analysis. Login/history work when it is omitted.
# Vercel deployments must use the public HTTPS origin of the deployed backend;
# localhost and private-network URLs are not reachable by remote browsers.
VITE_TRADINGAGENTS_API_URL=http://127.0.0.1:8000
